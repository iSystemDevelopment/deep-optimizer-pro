#!/bin/bash

#############################################################################
# Deep Optimizer Pro - Test Suite
# Version: 2.1.0
#############################################################################

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

# Test counters
PASSED=0
FAILED=0

# Simple assertion function
assert() {
    local message=$1
    shift
    local command="$@"
    
    echo -n "TEST: $message ... "
    if $command; then
        echo -e "${GREEN}PASSED${NC}"
        ((PASSED++))
    else
        echo -e "${RED}FAILED${NC}"
        ((FAILED++))
    fi
}

echo "Starting Deep Optimizer Pro Test Suite..."
echo "=========================================="

# --- 1. File Permissions ---
echo "Running File Permission Tests..."
assert "Make scripts executable" chmod +x *.sh modules/*.sh lib/*.sh

# --- 2. Syntax Check (Linting) ---
echo -e "\nRunning Syntax Checks (bash -n)..."
for file in $(find . -name "*.sh"); do
    assert "Syntax check $file" bash -n "$file"
done

# --- 3. ShellCheck (Requires shellcheck to be installed) ---
if command -v shellcheck &>/dev/null; then
    echo -e "\nRunning ShellCheck..."
    assert "ShellCheck main script" shellcheck deep-optimizer-pro.sh
    assert "ShellCheck modules" shellcheck modules/*.sh
    assert "ShellCheck lib" shellcheck lib/common.sh
else
    echo -e "\n${YELLOW}SKIPPING ShellCheck (install shellcheck to run)${NC}"
fi

# --- 4. Core Functionality Tests ---
# Note: These tests must be run in the project's root directory
echo -e "\nRunning Core Functionality Tests..."
assert "Run --version" ./deep-optimizer-pro.sh --version
assert "Run --help" ./deep-optimizer-pro.sh --help
assert "Run --dry-run" sudo ./deep-optimizer-pro.sh --full --dry-run
assert "Run storage module --dry-run" sudo ./deep-optimizer-pro.sh --module storage --dry-run
assert "Run performance module --dry-run" sudo ./deep-optimizer-pro.sh --module performance --dry-run
assert "Run security module --dry-run" sudo ./deep-optimizer-pro.sh --module security --dry-run

# --- 5. Report Results ---
echo "=========================================="
echo "Test Run Complete."
echo -e "${GREEN}PASSED: $PASSED${NC}"
echo -e "${RED}FAILED: $FAILED${NC}"

if [[ $FAILED -gt 0 ]]; then
    exit 1
fi
exit 0
