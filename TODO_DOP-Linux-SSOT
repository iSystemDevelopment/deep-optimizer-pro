This module fulfills goal "System reset/nuclear clean options killer" and includes the necessary confirmation prompt.

```bash
#!/bin/bash

#############################################################################
# Deep Optimizer Pro - System Reset Module
# Version: 2.1.0
# Description: Provides dangerous 'nuclear' cleaning options.
#############################################################################

# This script is intended to be sourced by deep-optimizer-pro.sh

# This module *requires* the confirm_action function
if ! command -v confirm_action &>/dev/null; then
    log_message ERROR "System Reset module failed to load: confirm_action not found."
    # Define a fallback to prevent script errors
    confirm_action() {
        log_message ERROR "Confirmation function missing. Aborting."
        return 1
    }
fi

nuclear_clean_user() {
    log_message WARNING "Starting USER profile nuclear clean."
    log_message WARNING "This will delete all caches, configs, and temporary app data for $USER."
    
    if ! confirm_action "Type 'YES' to delete all user caches/configs"; then
        log_message INFO "User profile clean aborted."
        return
    fi
    
    if [[ ${DRY_RUN:-false} == false ]]; then
        # Stop user services
        systemctl --user stop $(systemctl --user list-units --type=service --state=running | awk 'NR>1 {print $1}')
        
        # Delete common data directories
        rm -rf "$HOME/.cache"
        rm -rf "$HOME/.config"
        rm -rf "$HOME/.local/share"
        rm -rf "$HOME/.local/state"
        rm -rf "$HOME/.thumbnails"
    else
        log_message INFO "[DRY RUN] Would delete $HOME/.cache, $HOME/.config, $HOME/.local/*"
    fi
    
    log_message SUCCESS "User profile clean complete. Please log out."
}

nuclear_clean_system() {
    log_message WARNING "Starting SYSTEM nuclear clean."
    log_message WARNING "This will purge all system logs, all temp files, and all orphaned packages."
    
    if ! confirm_action "Type 'YES' to purge all system logs and orphans"; then
        log_message INFO "System clean aborted."
        return
    fi
    
    if [[ ${DRY_RUN:-false} == false ]]; then
        # Clean packages
        sudo $PKG_CLEAN
        # Clean system logs
        sudo find /var/log -type f -delete
        sudo journalctl --vacuum-size=1M
        # Clean all temp
        sudo rm -rf /tmp/*
        sudo rm -rf /var/tmp/*
    else
        log_message INFO "[DRY RUN] Would run $PKG_CLEAN"
        log_message INFO "[DRY RUN] Would delete all files in /var/log, /tmp, /var/tmp"
    fi
    
    log_message SUCCESS "System nuclear clean complete."
}

# Main function
run_reset_module_main() {
    log_message ERROR "--- DANGER: System Reset Module ---"
    
    echo "These operations are destructive and cannot be undone."
    echo "  1) Nuclear Clean USER Profile (Deletes all app configs/caches)"
    echo "  2) Nuclear Clean SYSTEM (Purges all logs, orphans, temp files)"
    echo "  0) Cancel"
    echo -n "Select an option: "
    read -r choice
    
    case $choice in
        1) nuclear_clean_user ;;
        2) nuclear_clean_system ;;
        *) log_message INFO "Cancelled." ;;
    esac
}

# Guard
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    DRY_RUN=${DRY_RUN:-false}
    LOG_DIR="/tmp"
    log_message() { echo "$*"; }
    
    if ! command -v init_common &>/dev/null; then
        source "$(dirname "$0")/../lib/common.sh" 2>/dev/null || true
        init_common
    fi
    
    run_reset_module_main "$@"
fi
